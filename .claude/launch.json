{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "praxis-backend",
      "runtimeExecutable": "backend/.venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "app.main:app", "--app-dir", "backend", "--host", "127.0.0.1", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "praxis-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev"],
      "port": 3000
    },
    {
      "name": "praxis-frontend-standalone",
      "runtimeExecutable": "node",
      "runtimeArgs": ["frontend/.next/standalone/server.js"],
      "port": 3000
    }
  ]
}
